rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if hasRole('ADMIN');
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id', 'email'])
      );
    }

    // --- Jobs ---
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if hasRole('RECRUITER') || hasRole('ADMIN');
      allow update: if (hasRole('RECRUITER') && resource.data.postedBy == request.auth.uid) || hasRole('ADMIN');
      allow delete: if (hasRole('RECRUITER') && resource.data.postedBy == request.auth.uid) || hasRole('ADMIN');
    }

    // --- Applications ---
    match /applications/{applicationId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        hasRole('ADMIN') || 
        (hasRole('RECRUITER') && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid)
      );
      
      allow list: if isSignedIn() && (
        hasRole('ADMIN') || 
        // Note: list queries must be secured by client filters matching this
        resource.data.studentId == request.auth.uid ||
        (hasRole('RECRUITER') && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid)
      );

      allow create: if hasRole('STUDENT') && request.resource.data.studentId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        hasRole('ADMIN') ||
        (hasRole('RECRUITER') && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid)
      );
    }
  }
}
